# ─────────────────────────────────────────────────────────────────────────────
# MCB Ghana HRM — Server Environment Configuration
# Copy to .env and fill in your values. Never commit .env to git.
# Last updated: 2026-06-27
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Render managed PostgreSQL — copy Internal Database URL from Render dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mcb_ghana_hrm?schema=public"

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT AUTH ──────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_A_128_CHAR_RANDOM_HEX_STRING"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_ANOTHER_128_CHAR_RANDOM_HEX_STRING"

# ── CORS / URLs ───────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"
CLIENT_URL="http://localhost:5173"
CORS_ORIGINS=""
API_BASE_URL="http://localhost:5000"

# ── REDIS (WebSocket Pub/Sub + BullMQ job queues) ─────────────────────────────
# On Render: auto-populated via fromService reference in render.yaml
# Local dev: install Redis locally or use upstash.com free tier
REDIS_URL="redis://localhost:6379"

# ── FIREBASE ADMIN SDK ────────────────────────────────────────────────────────
# Option A (recommended for Render): paste entire service-account JSON as one line
FIREBASE_ADMIN_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Option B: individual fields (used only if FIREBASE_ADMIN_SERVICE_ACCOUNT is not set)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_STORAGE_BUCKET="your-project.appspot.com"

# ── EMAIL (SMTP) ──────────────────────────────────────────────────────────────
# Gmail: use an App Password (not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=noreply@mcbghana.com

# ── PAYSTACK (payments) ───────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxx

# ── GEMINI AI (HR assistant / chatbot) ───────────────────────────────────────
GEMINI_API_KEY=AIzaSy...

# ── HUBTEL SMS ────────────────────────────────────────────────────────────────
HUBTEL_CLIENT_ID=your_client_id
HUBTEL_CLIENT_SECRET=your_client_secret
HUBTEL_SENDER_ID=MCBGHANA

# ── DOCUMENT VAULT ENCRYPTION ─────────────────────────────────────────────────
# Falls back to JWT_SECRET if not set — use a separate 64-char hex for isolation
DATA_ENCRYPTION_KEY="CHANGE_THIS_TO_A_64_CHAR_HEX_KEY"

# ── GOOGLE DRIVE BACKUP ───────────────────────────────────────────────────────
# Paste the entire service-account JSON as a single-line string
GOOGLE_DRIVE_KEY_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'

# ── BIOMETRIC / ATTENDANCE HARDWARE ──────────────────────────────────────────
BIOMETRIC_SYNC_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_KEY"

# ── DEV PORTAL ────────────────────────────────────────────────────────────────
DEV_MASTER_KEY="MCB-DEV-MASTER-2026-SECURE"
DEV_WHITELIST_EMAILS="johnsedofiadakey@gmail.com"
DEV_CONSOLE_PIN=""
ENABLE_DEV_ROUTES="false"
ENABLE_PRODUCTION_DEV_ROUTES="false"

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────
ALLOW_PUBLIC_SIGNUP="false"

# ── OPTIONAL INTEGRATIONS ────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=""
# Required for the destructive tenant-data purge endpoint. Use at least 16 random characters.
PURGE_RECOVERY_SECRET=

# Required only when running legacy/manual seed or recovery scripts. Never use a shared production password.
SEED_INITIAL_PASSWORD=
RECOVERY_ACCOUNT_PASSWORD=
