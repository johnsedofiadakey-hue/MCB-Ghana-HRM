  id               String   @id @default(uuid())
  organizationId   String
  shiftId          String
  lateAfterMins    Int      @default(10)
  halfDayAfterMins Int      @default(240)
  absentAfterMins  Int      @default(480)
  requiresGeoFence Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, shiftId])
}

model TaxRule {
  id             String       @id @default(uuid())
  organizationId String
  countryCode    String
  taxType        String
  name           String
  appliesTo      String?      @default("PAYROLL")
  isActive       Boolean      @default(true)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  brackets       TaxBracket[]

  @@index([organizationId, countryCode, taxType, isActive])
}

model TaxBracket {
  id             String   @id @default(uuid())
  organizationId String
  taxRuleId      String
  minAmount      Decimal
  maxAmount      Decimal?
  rate           Decimal
  fixedAmount    Decimal? @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  taxRule        TaxRule  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  @@index([organizationId, taxRuleId])
}

model SystemLog {
  id             String   @id @default(uuid())
  organizationId String?  @default("mcb-ghana-tenant")
  type           String?
  message        String?
  action         String?
  details        String?
  source         String?
  operatorId     String?
  operatorEmail  String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([type, createdAt])
}

model EmployeeReporting {
  id             String    @id @default(uuid())
  organizationId String?   @default("mcb-ghana-tenant")
  employeeId     String
  managerId      String
  type           String    @default("DIRECT")
  isPrimary      Boolean   @default(false)
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime  @default(now())
  employee       User      @relation("EmployeeReportingLines", fields: [employeeId], references: [id], onDelete: Cascade)
  manager        User      @relation("ManagerReportingLines", fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([employeeId, managerId, type])
  @@index([organizationId, employeeId])
  @@index([organizationId, managerId])
}

model KpiUpdate {
  id             String   @id @default(uuid())
  organizationId String?  @default("mcb-ghana-tenant")
  kpiItemId      String
  value          Decimal
  comment        String?
  submittedById  String?
  createdAt      DateTime @default(now())
  kpiItem        KpiItem  @relation(fields: [kpiItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, kpiItemId])
  @@index([createdAt])
}

model SupportTicket {
  id             String          @id @default(uuid())
  organizationId String?         @default("mcb-ghana-tenant")
  subject        String
  description    String
  category       String
  priority       String          @default("NORMAL")
  status         String          @default("OPEN")
  employeeId     String
  assignedToId   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assignedTo     User?           @relation("AssignedTickets", fields: [assignedToId], references: [id])
  employee       User            @relation("EmployeeTickets", fields: [employeeId], references: [id], onDelete: Cascade)
  comments       TicketComment[]

  @@index([organizationId, status])
  @@index([employeeId])
}

model TicketComment {
  id             String        @id @default(uuid())
  organizationId String?       @default("mcb-ghana-tenant")
  ticketId       String
  userId         String
  content        String
  attachmentUrl  String?
  createdAt      DateTime      @default(now())
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, ticketId])
}

model Lead {
  id             String   @id @default(uuid())
  name           String
  email          String
  company        String?
  phone          String?
  subject        String?
  message        String
  status         String   @default("NEW")
  organizationId String?  @default("stormglide-corp")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model DisciplinaryCase {
  id             String    @id @default(uuid())
  organizationId String?   @default("mcb-ghana-tenant")
  employeeId     String
  issuedById     String
  type           String
  category       String    @default("CONDUCT")
  reason         String
  details        String?
  evidence       String?
  status         String    @default("OPEN")
  outcome        String?
  hearingDate    DateTime?
  resolvedAt     DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       User      @relation("EmployeeDisciplinary", fields: [employeeId], references: [id], onDelete: Cascade)
  issuedBy       User      @relation("IssuedByDisciplinary", fields: [issuedById], references: [id])

  @@index([organizationId, employeeId])
  @@index([organizationId, status])
  @@index([organizationId, type])
}

model PolicyDocument {
  id              String                 @id @default(uuid())
  organizationId  String?                @default("mcb-ghana-tenant")
  title           String
  description     String?
  content         String?
  fileUrl         String?
  category        String                 @default("GENERAL")
  version         String                 @default("1.0")
  status          String                 @default("DRAFT")
  isRequired      Boolean                @default(true)
  targetRoles     String?
  publishedAt     DateTime?
  createdById     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  acknowledgments PolicyAcknowledgment[]
  createdBy       User                   @relation("PolicyCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, category])
}

model PolicyAcknowledgment {
  id             String         @id @default(uuid())
  organizationId String?        @default("mcb-ghana-tenant")
  policyId       String
  employeeId     String
  acknowledgedAt DateTime       @default(now())
  ipAddress      String?
  employee       User           @relation("PolicyAcknowledgedBy", fields: [employeeId], references: [id], onDelete: Cascade)
  policy         PolicyDocument @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, employeeId])
  @@index([organizationId, policyId])
  @@index([organizationId, employeeId])
}

model ProbationRecord {
  id             String    @id @default(uuid())
  organizationId String?   @default("mcb-ghana-tenant")
  employeeId     String    @unique
  startDate      DateTime
  endDate        DateTime
  period         Int       @default(90)
  status         String    @default("IN_PROGRESS")
  reviewDate     DateTime?
  reviewedById   String?
  outcome        String?
  goals          String?
  notes          String?
  alertSentAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       User      @relation("EmployeeProbation", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy     User?     @relation("ProbationReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, endDate])
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  keyHash        String       @unique
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model WebhookSubscription {
  id             String       @id @default(uuid())
  organizationId String
  url            String
  events         String
  isActive       Boolean      @default(true)
  secret         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
